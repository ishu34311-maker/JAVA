calculator
import java.util.*;

public class Main {
    public static void main(String[] args) {
     Scanner sc = new Scanner(System.in);
     int a = sc.nextInt();
     int b = sc.nextInt();
     String c = sc.next();
     
     if (c.equals("+")){
       System.out.println(a + b);
     } 
     else if (c.equals ("-")){
       System.out.println(a - b);
     }
     else if (c.equals("*")){
       System.out.println(a  *b);
     }
     else if (c.equals("/")){
       if (b == 0){
         System.out.println("not defined");
       }
       else {
         System.out.println(a / b);
       }
       
     }
     else if (c.equals ("%")){
       System.out.println(a % b);
     } 
     else {
       System.out.println("Ivalid operator");
     }
    sc.close;
    }
}

