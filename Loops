//prime or not
import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner sc = new Scanner(System.in);
      int n = sc.nextInt();
      Boolean isPrime = true;
      for(int i=2; i<=n/2; i++){
         if(n % i == 0){
           isPrime = false;
           break;
        }
      }
     if(isPrime){
       if (n ==1){
         System.out.println("no prime no composite");
       }else {
         System.out.println("prime no");
       }
     }else {
       System.out.println("not a prime number");
     }
    }
}

