      }
      System.out.println();
       }
    }
}

//Palindromic Pattern

import java.util.*;

public class Main {
    public static void main(String args[]) {
     int n = 5;

     //outer loop
     for (int i = 1; i<=n; i++){
      //spaces
      for (int j =1; j<=n-i; j++ ){
        System.out.print(" ");
      }
      //!st half numbers
      for(int j =i; j>=1; j--){
        System.out.print(j);
      }
      //2nd half numbers 
      for(int j = 2; j<=i; j++){
        System.out.print(j);
      }

      System.out.println();
     }

    }
}

//Diamond pattern

import java.util.*;

public class Main {
    public static void main(String args[]) {
     int n = 5;
     for (int i = 1; i<=n; i++){
      for (int j =1; j<=n-i;j++){
        System.out.print(" ");
      }

      for (int j =1; j<=2*i-1; j++){
        System.out.print("*");
      }
      System.out.println();
     }
      for (int i = n; i>=1; i--){
      for (int j =1; j<=n-i;j++){
        System.out.print(" ");
      }

      for (int j =1; j<=2*i-1; j++){
        System.out.print("*");
      }
      System.out.println();
     }


    }
}